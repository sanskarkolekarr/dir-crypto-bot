# Configuration for Crypto Wallet Scam Awareness Demo
# Copy this to .env.local and adjust values

# Minimum withdrawal bump (amount user enters + this = fake minimum)
NEXT_PUBLIC_MIN_BUMP=600

# Coin balances (comma-separated: id,name,balance,emoji)
# Default: Solana=90888, USDT=1300349, DAI=70000, ETH=388000
NEXT_PUBLIC_COINS=solana,Solana,90888,🟣|usdt,USDT,1300349,💚|dai,DAI,70000,🟡|eth,ETH,388000,🔵
